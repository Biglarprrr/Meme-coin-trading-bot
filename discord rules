"""
Grants/revokes the paid "Subscriber" role using the bot's own connection
to your server - no separate REST calls or a second bot token needed.

Requires:
- The bot has "Manage Roles" permission in the server
- The bot's own role sits ABOVE the Subscriber role in Server Settings ->
  Roles (Discord will silently refuse to assign a role positioned above
  the bot's own role - if grants seem to do nothing, check this first)
"""
import logging

from config import CONFIG

log = logging.getLogger("discord_roles")


async def grant_subscriber_role(bot, discord_user_id: str):
    guild = bot.get_guild(CONFIG.discord_guild_id)
    if guild is None:
        log.error("Bot is not in configured guild %s - check DISCORD_GUILD_ID", CONFIG.discord_guild_id)
        return

    role = guild.get_role(CONFIG.subscriber_role_id)
    if role is None:
        log.error("Subscriber role %s not found - check SUBSCRIBER_ROLE_ID", CONFIG.subscriber_role_id)
        return

    try:
        member = guild.get_member(int(discord_user_id)) or await guild.fetch_member(int(discord_user_id))
        await member.add_roles(role, reason="Stripe subscription activated")
        log.info("Granted %s to user %s", role.name, discord_user_id)
    except Exception as e:
        log.error("Failed to grant role to %s: %s", discord_user_id, e)


async def revoke_subscriber_role(bot, discord_user_id: str):
    guild = bot.get_guild(CONFIG.discord_guild_id)
    if guild is None:
        return

    role = guild.get_role(CONFIG.subscriber_role_id)
    if role is None:
        return

    try:
        member = guild.get_member(int(discord_user_id)) or await guild.fetch_member(int(discord_user_id))
        await member.remove_roles(role, reason="Stripe subscription ended")
        log.info("Revoked %s from user %s", role.name, discord_user_id)
    except Exception as e:
        log.error("Failed to revoke role from %s: %s", discord_user_id, e)
